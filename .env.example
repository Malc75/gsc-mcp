# gsc-mcp configuration. Environment variables only; copy to .env (git-ignored) or set them in your
# MCP client's config. Never commit real values.

# --- Credentials: choose ONE ---------------------------------------------------------------
# A) Service account key file (recommended). Add the key's client_email as a user on each
#    Search Console property.
GSC_SERVICE_ACCOUNT_FILE=/path/to/service-account.json

# B) OAuth user credentials (acts as you). A JSON file {"client_id","client_secret","refresh_token"}:
# GSC_OAUTH_FILE=/path/to/oauth.json
#    ...or the three values directly:
# GSC_OAUTH_CLIENT_ID=
# GSC_OAUTH_CLIENT_SECRET=
# GSC_OAUTH_REFRESH_TOKEN=

# --- Optional ----------------------------------------------------------------------------------
# Used when a tool call omits `site`
# GSC_DEFAULT_SITE=https://example.com/
# Enable the write tools (submit/delete sitemap, add/delete site). Off by default: read-only.
# GSC_ALLOW_WRITE=false

# --- HTTP mode only (gsc-mcp --http) ----------------------------------------------------------
# GSC_MCP_HOST=127.0.0.1
# GSC_MCP_PORT=3333
# Required in HTTP mode, at least 16 characters; clients send "Authorization: Bearer <token>"
# GSC_MCP_TOKEN=
